{
  "config_version": "1.0.0",
  "clustering_scope": "engagement",
  "similarity_threshold": 0.7,
  "min_cluster_size": 2,
  "facet_mode": "strict",
  "min_signal_confidence": 0.5,
  "proximity_threshold": 0.4,
  "proximity_top_n": 3,
  "min_rereview_members": 5,
  "enable_narration": true,
  "narration": {
    "command": "claude",
    "model": "claude-sonnet-5",
    "timeout_seconds": 120,
    "max_member_paths": 5
  }
}
