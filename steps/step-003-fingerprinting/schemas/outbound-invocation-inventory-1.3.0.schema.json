{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modernization-platform.internal/schemas/outbound-invocation-inventory-1.3.0.schema.json",
  "title": "outbound-invocation-inventory@1.3.0",
  "description": "Lifecycle step 5. See 29-ENTRY-POINT-AND-OUTBOUND-INVENTORIES.md Part C. One record per outbound dependency per project: mechanism, normalised endpoint (scheme, host, port, path \u2014 userinfo, query and fragment never stored), one binding per environment file, credentials by kind and key path only, and a Linux-compatibility verdict. No timestamp and no absolute path belong here: two runs over unchanged input are byte-identical. 1.1.0 (additive): a verdict on every environment binding (the invocation's verdict is the worst of them); usage (used | unused), with unused clients excluded from verdict and mechanism counts and counted in unusedCount; Kafka SASL mechanism where code or configuration states it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "artifactVersion",
    "scannerVersion",
    "repositoryId",
    "repositorySlug",
    "semanticAnalysisEnabled",
    "skipSource",
    "authDeclaredScope",
    "summary",
    "projects",
    "warnings"
  ],
  "properties": {
    "artifactType": {
      "const": "outbound-invocation-inventory"
    },
    "artifactVersion": {
      "const": "1.3.0"
    },
    "scannerVersion": {
      "type": "string"
    },
    "repositoryId": {
      "type": "string",
      "format": "uuid"
    },
    "repositorySlug": {
      "type": "string"
    },
    "semanticAnalysisEnabled": {
      "const": false
    },
    "skipSource": {
      "enum": [
        "application-fingerprint",
        "solution-project-inventory"
      ]
    },
    "authDeclaredScope": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectsScanned",
        "projectsSkipped",
        "projectsFailed",
        "invocationCount",
        "unusedCount",
        "countByMechanism",
        "countByVerdict"
      ],
      "properties": {
        "projectsScanned": {
          "type": "integer"
        },
        "projectsSkipped": {
          "type": "integer"
        },
        "projectsFailed": {
          "type": "integer"
        },
        "invocationCount": {
          "type": "integer"
        },
        "unusedCount": {
          "type": "integer",
          "minimum": 0
        },
        "countByMechanism": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "countByVerdict": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
