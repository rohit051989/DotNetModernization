<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WCF client matrix probe (29-ENTRY-POINT-AND-OUTBOUND-INVENTORIES.md C11):
       a minimal .NET 10 WCF client, run in a Linux container, that calls a real
       service with one binding, security mode and credential type and reports
       the outcome. Driven by `python -m app.estate.wcf_probe`; not part of a step. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
    <!-- WCF 8.1.2 brings System.Security.Cryptography.Xml 8.0.2, which has high-severity advisories:
         pinned to 10.0.12 unless -p:PinCryptographyXml=false, which probes what WCF brings by itself. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" Condition="'$(PinCryptographyXml)' != 'false'" />
  </ItemGroup>

</Project>
