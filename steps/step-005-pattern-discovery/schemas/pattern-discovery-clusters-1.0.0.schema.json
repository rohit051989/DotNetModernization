{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modernization-platform.internal/schemas/pattern-discovery-clusters-1.0.0.schema.json",
  "title": "pattern-discovery-clusters@1.0.0",
  "description": "See 23-STEP-005-PATTERN-DISCOVERY.md Part F. Documentation only in this implementation — not enforced at runtime (clustering/artifact.py builds the artifact directly from the same row shape persistence.py writes to the database, so the two cannot drift independently the way a hand-maintained schema could).",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "engagement_id", "similarity_method", "config", "clusters", "summary"],
  "properties": {
    "artifact_type": { "const": "pattern-discovery-clusters" },
    "artifact_version": { "const": "1.0.0" },
    "engagement_id": { "type": "string", "minLength": 1 },
    "similarity_method": { "type": "string", "const": "weighted_jaccard_v1" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold_strong", "threshold_weak", "category_weights"],
      "properties": {
        "threshold_strong": { "type": "number", "minimum": 0, "maximum": 1 },
        "threshold_weak": { "type": "number", "minimum": 0, "maximum": 1 },
        "category_weights": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
      }
    },
    "clusters": { "type": "array", "items": { "$ref": "#/$defs/cluster" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unmatched_input_count",
        "candidate_pattern_count",
        "unclustered_count",
        "structural_cluster_count",
        "llm_assisted_cluster_count"
      ],
      "properties": {
        "unmatched_input_count": { "type": "integer", "minimum": 0 },
        "candidate_pattern_count": { "type": "integer", "minimum": 0 },
        "unclustered_count": { "type": "integer", "minimum": 0 },
        "structural_cluster_count": { "type": "integer", "minimum": 0 },
        "llm_assisted_cluster_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "status",
        "formation_method",
        "applications",
        "common_signals",
        "similarity_score",
        "review_priority"
      ],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^CAND-.+-\\d{4}$" },
        "status": { "enum": ["candidate_pattern", "unclustered"] },
        "formation_method": { "enum": ["structural", "llm_assisted", null] },
        "applications": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uuid" }
        },
        "common_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "category"],
            "properties": {
              "name": { "type": "string" },
              "category": { "type": "string" }
            }
          }
        },
        "similarity_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "review_priority": { "enum": ["standard", "high"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "candidate_pattern" } } },
          "then": {
            "properties": {
              "formation_method": { "enum": ["structural", "llm_assisted"] },
              "similarity_score": { "type": "number" },
              "applications": { "minItems": 2 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unclustered" } } },
          "then": {
            "properties": {
              "formation_method": { "const": null },
              "similarity_score": { "const": null },
              "applications": { "minItems": 1, "maxItems": 1 }
            }
          }
        }
      ]
    }
  }
}
