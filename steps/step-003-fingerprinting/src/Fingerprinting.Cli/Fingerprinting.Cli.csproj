<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fingerprinting.Cli</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- MSBuild.Locator, Npgsql and JsonSchema.Net arrive through
       Fingerprinting.StepHost, shared with the entry-point inventory. Never
       reference Microsoft.Build.* directly here; see StepBootstrap.cs. -->

  <ItemGroup>
    <ProjectReference Include="..\Fingerprinting.Domain\Fingerprinting.Domain.csproj" />
    <ProjectReference Include="..\Fingerprinting.Analysis\Fingerprinting.Analysis.csproj" />
    <ProjectReference Include="..\Fingerprinting.Extractors\Fingerprinting.Extractors.csproj" />
    <ProjectReference Include="..\Fingerprinting.StepHost\Fingerprinting.StepHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\schemas\**\*.json">
      <Link>schemas\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
