<Project Sdk="Microsoft.NET.Sdk">

  <!-- Step 6, dependency-assessment (30-DEPENDENCY-ASSESSMENT.md).
       Feed resolution, version lookup, API diff and call-site search; the
       envelope and database live in Fingerprinting.Dependencies.Cli. Uses
       NuGet's own client libraries for feeds, credentials and packages
       (Part B2, B4) — the spec requires NuGet's resolution, not a copy. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fingerprinting.Dependencies</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fingerprinting.Domain\Fingerprinting.Domain.csproj" />
    <ProjectReference Include="..\Fingerprinting.Analysis\Fingerprinting.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Credentials" Version="7.9.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <!-- NuGet.Packaging 7.9.0 asks for System.Security.Cryptography.Pkcs 8.0.1, which has two known
         advisories (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate; both .NET denial of
         service). 8.0.2 is the oldest release that fixes both and still satisfies NuGet.Packaging. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

</Project>
