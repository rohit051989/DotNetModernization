<Project Sdk="Microsoft.NET.Sdk">

  <!-- Step 6's own published binary: its own registration, artifact and
       tables. Published to publish/dependency-assessment/.

       DisableMSBuildAssemblyCopyCheck: StepHost references MSBuildLocator
       for steps 3 to 5, and the locator refuses a project that also ships
       NuGet's libraries. Step 6 never loads MSBuild — it starts with
       StepBootstrap.Initialise(registerMsBuild: false) — so its NuGet copies
       are the only ones in the process, which is what the check guards. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fingerprinting.Dependencies.Cli</RootNamespace>
    <AssemblyName>DependencyAssessment.Cli</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fingerprinting.Domain\Fingerprinting.Domain.csproj" />
    <ProjectReference Include="..\Fingerprinting.Dependencies\Fingerprinting.Dependencies.csproj" />
    <ProjectReference Include="..\Fingerprinting.StepHost\Fingerprinting.StepHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\schemas\dependency-assessment-1.2.0.schema.json">
      <Link>schemas\dependency-assessment-1.2.0.schema.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
