<Project Sdk="Microsoft.NET.Sdk">

  <!-- Step 5's own published binary (29-ENTRY-POINT-AND-OUTBOUND-INVENTORIES.md Part A1):
       its own registration, artifact and tables. Published to
       publish/outbound-invocation-inventory/ so it never overwrites steps 3 or 4. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fingerprinting.Outbound.Cli</RootNamespace>
    <AssemblyName>OutboundInvocationInventory.Cli</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fingerprinting.Domain\Fingerprinting.Domain.csproj" />
    <ProjectReference Include="..\Fingerprinting.Analysis\Fingerprinting.Analysis.csproj" />
    <ProjectReference Include="..\Fingerprinting.Outbound\Fingerprinting.Outbound.csproj" />
    <ProjectReference Include="..\Fingerprinting.StepHost\Fingerprinting.StepHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\schemas\outbound-invocation-inventory-1.5.0.schema.json">
      <Link>schemas\outbound-invocation-inventory-1.5.0.schema.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\schemas\wcf-client-support-1.1.0.json">
      <Link>schemas\wcf-client-support-1.1.0.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\schemas\wcf-client-platform-1.2.0.json">
      <Link>schemas\wcf-client-platform-1.2.0.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
