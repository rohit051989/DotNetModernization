<Project Sdk="Microsoft.NET.Sdk">

  <!-- Step 8's own published binary: its own registration, artifact,
       tables and cache. Published to publish/test-coverage-assessment/. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fingerprinting.TestCoverage.Cli</RootNamespace>
    <AssemblyName>TestCoverageAssessment.Cli</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fingerprinting.Domain\Fingerprinting.Domain.csproj" />
    <ProjectReference Include="..\Fingerprinting.TestCoverage\Fingerprinting.TestCoverage.csproj" />
    <ProjectReference Include="..\Fingerprinting.StepHost\Fingerprinting.StepHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\schemas\test-coverage-1.0.0.schema.json">
      <Link>schemas\test-coverage-1.0.0.schema.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
