<Project Sdk="Microsoft.NET.Sdk">

  <!-- dependency-hierarchy's own published binary: its own registration, artifact and tables. Published to
       publish/dependency-hierarchy/. As dependency-assessment's CLI, it never loads MSBuild and ships NuGet's
       libraries, so the MSBuildLocator copy check StepHost brings is turned off. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fingerprinting.Hierarchy.Cli</RootNamespace>
    <AssemblyName>DependencyHierarchy.Cli</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fingerprinting.Domain\Fingerprinting.Domain.csproj" />
    <ProjectReference Include="..\Fingerprinting.Hierarchy\Fingerprinting.Hierarchy.csproj" />
    <ProjectReference Include="..\Fingerprinting.Dependencies.Cli\Fingerprinting.Dependencies.Cli.csproj" />
    <ProjectReference Include="..\Fingerprinting.StepHost\Fingerprinting.StepHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\schemas\dependency-hierarchy-1.0.0.schema.json">
      <Link>schemas\dependency-hierarchy-1.0.0.schema.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
