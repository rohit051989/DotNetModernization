.venv/
__pycache__/
*.pyc
.env
node_modules/
dist/
.vite/
# Engagement data never enters git (CLAUDE.md: git holds the platform only). Run output, verifications and
# experiments live under RUNS_DIR, by default backend/runs/; a client deployment sets RUNS_DIR outside the
# repository (01-ENVIRONMENT-SETUP.md section 9). An experiments folder anywhere in the tree is ignored too.
backend/runs/
runs/
experiments/

# Local run output: server logs and step result envelopes name engagements and repositories.
*.log
/out*.json

# .NET (steps/step-003-fingerprinting and any later .NET step)
bin/
obj/
steps/*/publish/
steps/*/tests/fixtures/sample-output/

# Local-only SARIF sibling (25-STANDARDS-AND-VIEWPOINTS.md Part A3): embeds
# this machine's absolute repository path for viewer resolution, so it's
# never the registered/checksummed output and never committed.
*.local.sarif

# Database dumps hold client data and are never committed.
# scripts/reset-demo.ps1 writes its backups outside the repository; these
# patterns catch one copied in by hand.
*.dump
*.backup
*.pgdump
backups/
