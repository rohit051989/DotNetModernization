    "projectSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unusedCount",
        "countByMechanism",
        "countByVerdict",
        "incompatible"
      ],
      "properties": {
        "unusedCount": {
          "type": "integer",
          "minimum": 0
        },
        "countByMechanism": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "countByVerdict": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "incompatible": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invocationId",
              "mechanism",
              "endpoint",
              "reasons"
            ],
            "properties": {
              "invocationId": {
                "type": "string"
              },
              "mechanism": {
                "enum": [
                  "http_client",
                  "soap_client",
                  "grpc_client",
                  "database",
                  "message_producer",
                  "message_consumer",
                  "cache",
                  "secret_store",
                  "file_share",
                  "smtp",
                  "ldap"
                ]
              },
              "endpoint": {
                "type": "string"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "projectPath",
        "status",
        "skipReason",
        "summary",
        "invocations",
        "warnings",
        "deployParameters",
        "entryPointBackend"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "projectPath": {
          "type": "string"
        },
        "status": {
          "enum": [
            "SCANNED",
            "SKIPPED",
            "FAILED"
          ]
        },
        "skipReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "$ref": "#/$defs/projectSummary"
        },
        "invocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invocation"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        },
        "deployParameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployParameter"
          }
        },
        "entryPointBackend": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entryPointBackend"
          }
        }
      }
    },
    "invokedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "verb",
        "path",
        "member",
        "resolution",
        "reason",
        "callSite"
      ],
      "properties": {
        "operation": {
          "type": [
            "string",
            "null"
          ],
          "description": "SOAP: the method called on the proxy or channel. gRPC: the RPC. Null for HTTP and when unresolved."
        },
        "verb": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS",
            null
          ],
          "description": "HTTP only."
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "HTTP only: the request path, base-address path prefixed; unread parts written {\u2026}."
        },
        "member": {
          "type": [
            "string",
            "null"
          ],
          "description": "The member invoked, as written."
        },
        "resolution": {
          "enum": [
            "resolved",
            "partial",
            "unresolved"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why unresolved, or how an indirect call was found."
        },
        "callSite": {
          "$ref": "#/$defs/callSite"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "deployParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectPath",
        "sourceFile",
        "environment",
        "name",
        "kind",
        "line",
        "value",
        "linkedKind",
        "linkedName",
        "linkMethod",
        "linkConfidence",
        "linkNote"
      ],
      "properties": {
        "projectPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceFile": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "url",
            "path",
            "connection_string",
            "sensitive",
            "other"
          ]
        },
        "line": {
          "type": "integer"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "description": "Only for a path, or a URL linked to an endpoint a used invocation cites (normalised)."
        },
        "linkedKind": {
          "enum": [
            "client_endpoint",
            "app_setting",
            "connection_string",
            "xpath",
            null
          ]
        },
        "linkedName": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkMethod": {
          "enum": [
            "parameters_xml",
            "name_and_path",
            null
          ]
        },
        "linkConfidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "linkNote": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "sensitive",
                  "connection_string",
                  "other"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "backendCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "mechanism",
        "operation",
        "callSite",
        "depth",
        "via",
        "conditional",
        "inLoop",
        "context"
      ],
      "properties": {
        "invocationId": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "callSite": {
          "$ref": "#/$defs/callSite"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditional": {
          "type": "boolean"
        },
        "inLoop": {
          "type": "boolean"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unfollowedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "callSite"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "callSite": {
          "$ref": "#/$defs/callSite"
        }
      }
    },
    "entryPointBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryPointId",
        "status",
        "calls",
        "unresolved"
      ],
      "properties": {
        "entryPointId": {
          "type": "string"
        },
        "status": {
          "enum": [
            "yes",
            "no",
            "unresolved"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/backendCall"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unfollowedPath"
          }
        }
      }
    }
  }
}
