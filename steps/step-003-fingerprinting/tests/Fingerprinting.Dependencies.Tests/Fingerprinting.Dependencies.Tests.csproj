<Project Sdk="Microsoft.NET.Sdk">

  <!-- Step 6's tests, apart from Fingerprinting.Tests: step 6 ships NuGet's
       client libraries, and Fingerprinting.Tests loads MSBuild through
       MSBuildLocator (steps 3 to 5), which must not see a second copy of
       NuGet.Frameworks. Offline: feeds are local folders built by the tests. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fingerprinting.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- As in the step 6 CLI: StepHost (for the schema validator) brings
         MSBuildLocator, which refuses NuGet's libraries beside it. These
         tests never load MSBuild, so the copies here are the only ones. -->
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fingerprinting.Dependencies\Fingerprinting.Dependencies.csproj" />
    <!-- ArtifactSchemaValidator: artifacts are checked against the schema the step publishes. -->
    <ProjectReference Include="..\..\src\Fingerprinting.StepHost\Fingerprinting.StepHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\schemas\dependency-assessment-1.6.0.schema.json">
      <Link>schemas\dependency-assessment-1.6.0.schema.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\schemas\shared-frameworks-1.0.0.json">
      <Link>schemas\shared-frameworks-1.0.0.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
