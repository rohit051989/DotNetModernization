# Copy to backend/.env (gitignored) and fill in. 01-ENVIRONMENT-SETUP.md sections 9 and 10.

# The database: where it is. Every table, sequence and the migration version table live in DB_SCHEMA.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=modernization_catalog
DB_SCHEMA=public
# Who connects: environment only. Set these in the environment, or here (this file is never committed).
# They are never written anywhere else and never logged.
DB_USER=catalog
DB_PASSWORD=catalog_dev_pw

# Engagement data (run output, worktrees, conversions, verifications): an absolute folder OUTSIDE the repository.
RUNS_DIR=C:\ModernizationPlatform\runs

API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# client (the default) or demo. Only DEPLOYMENT=demo lets scripts/reset-demo.ps1 clear engagements and repositories:
# a client deployment's database is the only copy of that client's data.
DEPLOYMENT=client

# Package sources for the platform's own dependencies (scripts/bootstrap.ps1). Empty: the public defaults.
PIP_INDEX_URL=
NPM_REGISTRY=
# Comma-separated NuGet feed URLs or folders for building the step programs.
NUGET_SOURCES=
# Dependency assessment compares a client feed with nuget.org; switch off where nuget.org is unreachable.
COMPARE_PUBLIC_NUGET_FEED=true
